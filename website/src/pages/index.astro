<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>sablier</title>
		<link rel="stylesheet" href="/tokens.css" />
		<meta
			name="description"
			content="open source time tracker to track the time you actually spend on making things."
		/>
	</head>
	<body>
		<main>
			<div class="center">
				<h1>sablier</h1>
				<div class="buttons">
					<a href="/auth/login">Log in</a>
					<a href="/docs/">Docs</a>
					<a href="https://github.com/espcaa/sablier">GitHub</a>
				</div>
				<div class="chips">
					<span class="chip">
						<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
						<span><strong><span data-glitch>14</span>m today</strong></span>
					</span>
					<span class="chip">
						<span>works with</span>
						<svg viewBox="0 0 24 24" role="img" aria-label="Claude Code"><path fill="currentColor" d="M21 10.5h3v3h-3v3h-1.5v3H18v-3h-1.5v3H15v-3H9v3H7.5v-3H6v3H4.5v-3H3v-3H0v-3h3v-6h18Zm-15 0h1.5v-3H6Zm10.5 0H18v-3h-1.5z" /></svg>
						<svg viewBox="0 0 24 24" role="img" aria-label="opencode"><path fill="currentColor" d="M22 24H2V0h20zM17 4.8H7v14.4h10z" /></svg>
						<svg viewBox="0 0 24 24" role="img" aria-label="Codex"><path d="m5 7 5 5-5 5M12 19h7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</span>
				</div>
			</div>
		</main>
		<script>
			// random minutes, unless motion is reduced
			const el = document.querySelector<HTMLElement>("[data-glitch]");
			if (el && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
				setInterval(() => {
					el.textContent = String(Math.floor(Math.random() * 100)).padStart(2, "0");
				}, 70);
			}
		</script>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		background: var(--color-canvas);
		color: var(--color-ink);
		font-family: var(--font-text);
	}
	main {
		flex: 1;
		display: grid;
		place-items: center;
	}
	.center {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}
	/* material 3 assist chips */
	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2rem;
		padding: 0 1rem 0 0.5rem;
		border: 1px solid color-mix(in oklch, var(--color-muted), var(--color-border) 60%);
		border-radius: 0.5rem;
		background: var(--color-surface);
		color: var(--color-ink);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
	}
	.chip svg {
		width: 1.125rem;
		height: 1.125rem;
		color: var(--color-accent);
		flex: none;
	}
	.chip strong {
		font-variant-numeric: tabular-nums;
		font-weight: 600;
	}
	.chip:last-child {
		padding: 0 0.75rem 0 1rem;
	}
	h1 {
		margin: 0;
		font-weight: 600;
		font-size: clamp(3.5rem, 13vw, 9rem);
		font-style: italic;
		letter-spacing: -0.04em;
		line-height: 0.9;
	}
	.buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.375rem;
	}
	.buttons a {
		background: var(--color-accent);
		color: var(--color-surface);
		text-decoration: none;
		font-weight: 500;
		padding: 0.6rem 1.4rem;
		border-radius: var(--radius);
	}
	.buttons a:hover {
		background: color-mix(in oklch, var(--color-accent), var(--color-ink) 15%);
	}
	.buttons a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
</style>
